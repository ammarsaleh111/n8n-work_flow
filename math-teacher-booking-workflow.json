      "parameters": {
        "authentication": "oAuth2",
        "operation": "append",
        "sheetId": "YOUR_SHEET_ID",
        "range": "Sheet1!A:F",
        "options": {},
        "fields": {
          "values": [
            "={{$json.student_name}}",
            "={{$json.phone}}",
            "={{$json.address}}",
            "={{$json.prep_year}}",
            "={{$json.performance_range}}",
            "={{$now.toISO()}}"
          ]
        }
      },
      "id": "AppendToSheet",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [4600, 100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_OAUTH_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
