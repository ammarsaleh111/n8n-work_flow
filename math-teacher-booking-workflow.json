{
  "name": "Math Teacher Booking Assistant (Telegram)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "TelegramTrigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "chat_id",
              "value": "={{$json.message.chat.id}}"
            }
          ]
        }
      },
      "id": "StoreChatId",
      "name": "Store Chat Id",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "Which prep year are you in?",
        "additionalFields": {
          "replyMarkup": "={\"keyboard\":[[\"1 prep\"],[\"2 prep\"],[\"3 prep\"]],\"one_time_keyboard\":true,\"resize_keyboard\":true}"
        }
      },
      "id": "AskPrepYear",
      "name": "Ask Prep Year",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [400, 0],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "waitFor": "webhook",
        "options": {
          "responseMode": "onReceived"
        }
      },
      "id": "WaitPrepYear",
      "name": "Wait for Prep Year",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.message.text}}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "PrepYearEmpty",
      "name": "Prep Year Empty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 0]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "prep_year",
              "value": "={{$json.message.text}}"
            }
          ]
        }
      },
      "id": "StorePrepYear",
      "name": "Store Prep Year",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "chatId": "={{$json.chat_id}}",
        "text": "What was your overall grade last year?",
        "additionalFields": {
          "replyMarkup": "={\"keyboard\":[[\"90–100 %\"],[\"80–90 %\"],[\"70–80 %\"],[\"Below 70 %\"]],\"one_time_keyboard\":true,\"resize_keyboard\":true}"
        }
      },
      "id": "AskPerformance",
      "name": "Ask Performance",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1200, 0],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "waitFor": "webhook",
        "options": {
          "responseMode": "onReceived"
        }
      },
      "id": "WaitPerformance",
      "name": "Wait for Performance",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1400, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.message.text}}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "PerformanceEmpty",
      "name": "Performance Empty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1600, 0]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "performance_range",
              "value": "={{$json.message.text}}"
            }
          ]
        }
      },
      "id": "StorePerformance",
      "name": "Store Performance",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1800, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.performance_range}}",
              "operation": "equal",
              "value2": "Below 70 %"
            }
          ]
        }
      },
      "id": "RejectLowPerformance",
      "name": "Reject Low Performance?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2000, 0]
